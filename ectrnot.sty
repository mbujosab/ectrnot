%% Este paquete sustituye a nacal-probabilidad y nacal-econometria, y no
%% puede convivir con ellos ni con alprobnot: definen los mismos nombres.
\@ifpackageloaded{nacal-probabilidad}{%
  \PackageError{ectrnot}{nacal ya ha cargado su notacion de probabilidad}%
    {Carga nacal con la opcion soloAL: \string\usepackage[soloAL]{nacal}}}{}
\@ifpackageloaded{alprobnot}{%
  \PackageError{ectrnot}{ectrnot y alprobnot no se pueden cargar a la vez}%
    {Los dos definen la notacion de probabilidad; usa solo uno.}}{}
\@ifpackageloaded{nacal}{}{\RequirePackage[soloAL]{nacal}}
